{
  "theme": { "name": "default" },
  "style": {
    "fontFamily": "-apple-system-font,BlinkMacSystemFont, Helvetica Neue, PingFang SC, Microsoft YaHei, Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#FF6A00",
    "textColor": "#3F3F3F",
    "bgColor": "#FFFFFF",
    "lineHeight": 1.85
  },
  "codeBlock": {
    "themeName": "github",
    "isMacStyle": false,
    "showLineNumber": false
  },
  "content": {
    "countStatus": false,
    "useIndent": false,
    "useJustify": false,
    "padding": "18px 16px"
  },
  "customCSS": "h1{display:block;margin:1.2em 8px 2em;padding:0 0 .55em;border-bottom:2px solid #FF6A00;color:#202124;font-size:1.55em;line-height:1.4;text-align:left}h2{display:block;margin:2.2em 8px 1em;padding:0 0 0 12px;border-left:3px solid #FF6A00;background:transparent;color:#202124;font-size:1.25em;line-height:1.5;text-align:left}h3{margin:1.6em 8px .7em 0;padding:0;color:#D95B00;border:0;font-size:1.08em}strong{color:#222}blockquote{margin:1.2em 8px;padding:.75em 1em;border-left:3px solid #FFB066;border-radius:0;background:#FFF8F1;color:#5B4636}table{font-size:14px}th{background:#FFF3E8!important;color:#5B4636!important}hr{border:0;border-top:1px solid #E8E8E8;margin:2em 8px}"
}
