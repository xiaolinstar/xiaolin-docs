# GitHub L2（xiaolin-docs）
#
# Secrets（仓库级）：
#   SERVER_HOST / SERVER_USER / SERVER_PASSWORD — CD SSH
#   MAIL_USERNAME / MAIL_PASSWORD — 部署通知邮件
#
# Variables（仓库级）：
#   DOCKER_BAIDU_ANALYTICS_ID — ci-ghcr.yml 构建镜像
#   PAGES_BAIDU_ANALYTICS_ID — page.yml GitHub Pages
#
# 推荐流程：
#   cp docs/env/github-production.env ~/.config/xiaolinstar/xiaolin-docs/github-production.env
#   pnpm sync:github-env -- --dry-run
#   pnpm sync:github-env

SERVER_HOST=124.222.98.227
SERVER_USER=ubuntu
SERVER_PASSWORD=<ssh password>
DOCKER_BAIDU_ANALYTICS_ID=<baidu id>
PAGES_BAIDU_ANALYTICS_ID=<baidu id>
MAIL_USERNAME=<qq mail>
MAIL_PASSWORD=<qq auth code>
