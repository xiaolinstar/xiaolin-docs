# GitHub L2 本地清单（仓库级 Secrets + Variables）
# 复制到：
#   ~/.config/xiaolinstar/xiaolin-docs/github-production.env

GITHUB_REPOSITORY=xiaolinstar/xiaolin-docs

# Required：CD 部署目标（内容 upstream VPS）
SERVER_HOST=124.222.98.227
SERVER_USER=ubuntu
SERVER_PASSWORD=change-me

# Optional：CI 构建 / Pages 百度统计（仓库 Variables）
DOCKER_BAIDU_ANALYTICS_ID=
PAGES_BAIDU_ANALYTICS_ID=

# Optional：CD 成功邮件（仓库 Secrets）
MAIL_USERNAME=
MAIL_PASSWORD=
