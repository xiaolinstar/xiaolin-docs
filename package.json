{
  "version": "0.1.0",
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "cytoscape": "^3.33.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.21",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.1",
    "markdown-it-task-list-plus": "^2.1.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.15.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.12.2",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check-links": "node scripts/check-docs-links.mjs",
    "media:check": "bash scripts/cos-check.sh",
    "media:upload": "bash scripts/upload-media-cos.sh docs/public/images",
    "media:rewrite": "python3 scripts/rewrite-media-urls.py",
    "media:rewrite:apply": "python3 scripts/rewrite-media-urls.py --apply",
    "media:cdn-check": "bash scripts/cdn-check.sh",
    "media:cdn-migrate": "python3 scripts/rewrite-cos-to-cdn.py",
    "media:cdn-migrate:apply": "python3 scripts/rewrite-cos-to-cdn.py --apply",
    "media:normalize": "python3 scripts/normalize-media-names.py",
    "media:normalize:apply": "python3 scripts/normalize-media-names.py --apply",
    "sync:github-env": "node scripts/cd/sync-github-env.mjs",
    "test:glossary": "node --test --experimental-strip-types docs/.vitepress/glossary/matchTerms.test.ts docs/.vitepress/glossary/plugin.test.ts"
  }
}
