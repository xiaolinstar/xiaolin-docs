# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 百度统计 ID
# 从百度统计后台获取，格式如：https://hm.baidu.com/hm.js?YOUR_ID
# 在 GitHub 中配置：Settings > Variables > Actions > New repository variable
VITE_BAIDU_ANALYTICS_ID=45b5122cbf32f062db08391b7f41cf2e

# 网站基础路径
# 区分 GitHub 部署和常规部署
VITE_BASE_PATH=/

# 网站标题
VITE_SITE_TITLE=AI持续运维

# 网站描述
VITE_SITE_DESCRIPTION=SRE、DevOps 与 AI 技术实践平台
