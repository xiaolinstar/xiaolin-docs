# 复制为 .env 本地使用，勿提交 .env
#
# COS 凭证（SecretId / SecretKey）放在 ~/.cos.yaml（coscli），不要写进 .env。
# Bucket alias / name / endpoint 默认从 ~/.cos.yaml 自动读取，一般无需在 .env 填写。

# --- VitePress 本地构建 / 开发 ---

# 百度统计 ID（CI 用 GitHub Variables：DOCKER_BAIDU_ANALYTICS_ID）
VITE_BAIDU_ANALYTICS_ID=45b5122cbf32f062db08391b7f41cf2e

VITE_BASE_PATH=/
VITE_SITE_TITLE=AI持续运维
VITE_SITE_DESCRIPTION=SRE、DevOps 与 AI 技术实践平台

# --- COS / CDN 媒体上传（与 xiaolin-life 共用 Bucket，前缀 docs/）---

# COS_BUCKET_ALIAS=media-1300240022
# COS_BUCKET_NAME=media-1300240022
# COS_REGION=ap-nanjing

MEDIA_CDN_BASE=https://media.xiaolin.fun
COS_PREFIX=docs
